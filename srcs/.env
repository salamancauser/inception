# Non-secret configuration only. Passwords live in ../secrets/ and are mounted
# as Docker secrets. This file is gitignored and must be recreated per machine.

# --- identity -----------------------------------------------------------
DOMAIN_NAME=zzin.42.fr
LOGIN=zzin

# Host path backing the two named volumes. This is the ONE value that differs
# between machines, because it follows the unix user, not the 42 login.
# The Makefile exports its own value and overrides whatever is set here.
DATA_PATH=/home/mesmaz/data

# --- database -----------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_HOST=mariadb

# --- wordpress ----------------------------------------------------------
WP_VERSION=6.7.1
WP_TITLE=Inception
WP_ADMIN_USER=zzin
WP_ADMIN_EMAIL=zzin@student.42.fr
WP_USER=guest
WP_USER_EMAIL=guest@student.42.fr
