server {
    # 443 only, and TLS only. No port 80, no plain-HTTP redirect: the subject
    # allows exactly one entry point into the whole infrastructure.
    # http2 as a `listen` flag — bookworm ships nginx 1.22, and the separate
    # `http2 on;` directive only exists from 1.25.1 onwards.
    listen              443 ssl http2;
    listen              [::]:443 ssl;

    server_name         ${DOMAIN_NAME};

    ssl_certificate     /etc/nginx/ssl/inception.crt;
    ssl_certificate_key /etc/nginx/ssl/inception.key;

    # Mandated by the subject. Everything older (SSLv3, TLSv1.0, TLSv1.1) has
    # known breaks and is refused — `curl --tlsv1.1 --tls-max 1.1` must fail.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # The wordpress named volume, mounted here as well as in the wordpress
    # container. nginx serves the static files directly; only .php is handed
    # over to php-fpm.
    root                /var/www/html;
    index               index.php index.html;

    client_max_body_size 64M;

    location / {
        # WordPress permalinks: if no real file matches, let index.php route it.
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;

        # Resolved by docker's embedded DNS on the user-defined bridge network:
        # "wordpress" is the service name. This is why `links:` is obsolete.
        fastcgi_pass    wordpress:9000;
        fastcgi_index   index.php;

        include         fastcgi_params;
        # nginx cannot execute PHP. It passes the file PATH to php-fpm, which
        # runs the code and returns the output — that is what FastCGI is.
        fastcgi_param   SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param   PATH_INFO       $fastcgi_path_info;
        fastcgi_read_timeout 300;
    }

    # Never serve these, even if something drops one in the web root.
    location ~ /\.(ht|git) {
        deny all;
    }
}
